# Copy to android/keystore.properties (git-ignored) to sign release builds locally.
# Paths are relative to the android/ directory. Never commit the real file or the keystore.
#
# Create a keystore once (keep it and the passwords safe — Play updates require the same key):
#   keytool -genkeypair -v -keystore polyglot-release.jks -alias polyglot \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=polyglot-release.jks
storePassword=change-me
keyAlias=polyglot
keyPassword=change-me
